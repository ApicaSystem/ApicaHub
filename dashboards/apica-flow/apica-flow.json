{
  "header": {
    "dateTimeRange": true,
    "data_source_type": "apica_ascent_prometheus",
    "dropdowns": [
      {
        "pipelineName": {
          "query": "group by (pipelineName) (apica_ingest_pipeline > 0)",
          "name": "Pipeline selection",
          "placeholder": "Select pipeline",
          "data_source_name": "Ascent Metrics"
        }
      },
      {
        "exported_namespace": {
          "query": "group by (exported_namespace) (apica_ingest_pipeline_status{pipelineName=~'.*'} > 0)",
          "name": "Namespace selection",
          "placeholder": "Select Namespace",
          "data_source_name": "Ascent Metrics"
        }
      },
      {
        "app": {
          "query": "group by (app) (apica_ingest_pipeline_status{pipelineName=~'.*', exported_namespace=~'.*'} > 0)",
          "name": "App selection",
          "placeholder": "Select App",
          "data_source_name": "Ascent Metrics"
        }
      }
    ]
  },
  "tabs": [
    {
      "key": "Overview",
      "order": "1",
      "title": "Overview",
      "type": "metrics",
      "queriesList": [
        {
          "chart_type": "counter",
          "data_source_name": "Ascent Metrics",
          "name": "Active Pipelines",
          "options": {
            "description": "Pipelines currently mapped to at least one dataflow. Current state; ignores the time range.",
            "label": "Pipelines",
            "order": 1
          },
          "query": "count(group by (pipelineName)(apica_ingest_pipeline_status{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'} > 0)) or vector(0)",
          "schema": "apica_ingest_pipeline_status"
        },
        {
          "chart_type": "size",
          "data_source_name": "Ascent Metrics",
          "name": "Events In",
          "options": {
            "description": "Events that entered pipelines in the selected time range.",
            "label": "Events In",
            "plot": {
              "errorColumn": "",
              "groupBy": "",
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "",
              "datatype": "number",
              "sizeConfig": {
                "valueColumn": "value"
              }
            },
            "order": 2
          },
          "query": "sum(increase(apica_pipeline_events_in{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__range}}])) or vector(0)&duration=1h",
          "schema": "apica_pipeline_events_in"
        },
        {
          "chart_type": "size",
          "data_source_name": "Ascent Metrics",
          "name": "Events Out",
          "options": {
            "description": "Events that left pipelines in the selected time range.",
            "label": "Events Out",
            "plot": {
              "errorColumn": "",
              "groupBy": "",
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "",
              "datatype": "number",
              "sizeConfig": {
                "valueColumn": "value"
              }
            },
            "order": 3
          },
          "query": "sum(increase(apica_pipeline_events_out{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__range}}])) or vector(0)&duration=1h",
          "schema": "apica_pipeline_events_out"
        },
        {
          "chart_type": "size",
          "data_source_name": "Ascent Metrics",
          "name": "Events Filtered",
          "options": {
            "description": "Events dropped by pipeline rules in the selected time range.",
            "label": "Events Filtered",
            "plot": {
              "errorColumn": "",
              "groupBy": "",
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "",
              "datatype": "number",
              "sizeConfig": {
                "valueColumn": "value"
              }
            },
            "order": 4
          },
          "query": "sum(increase(apica_pipeline_dropped_logs_counter{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__range}}])) or vector(0)&duration=1h",
          "schema": "apica_pipeline_dropped_logs_counter"
        },
        {
          "chart_type": "size",
          "data_source_name": "Ascent Metrics",
          "name": "Bytes Saved",
          "options": {
            "description": "Bytes removed by pipeline rules (dropped events, removed or masked fields, shortened messages) in the selected time range.",
            "label": "Bytes Saved",
            "plot": {
              "errorColumn": "",
              "groupBy": "",
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "",
              "datatype": "bytes",
              "sizeConfig": {
                "valueColumn": "value"
              }
            },
            "order": 5
          },
          "query": "sum(increase(apica_pipeline_savings_bytes{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__range}}])) or vector(0)&duration=1h",
          "schema": "apica_pipeline_savings_bytes"
        },
        {
          "chart_type": "counter",
          "data_source_name": "Ascent Metrics",
          "name": "Volume Reduction",
          "options": {
            "description": "Share of ingested bytes that pipelines did not pass on: 1 - bytes out / bytes in, over the selected time range.",
            "label": "% reduction",
            "order": 6
          },
          "query": "round((1 - sum(increase(apica_ingest_pipeline_bytes_out{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__range}}])) / (sum(increase(apica_ingest_pipeline_bytes_in{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__range}}])) > 0)) * 100, 0.1) or vector(0)&duration=1h",
          "schema": "apica_ingest_pipeline_bytes_in"
        },
        {
          "chart_type": "size",
          "data_source_name": "Ascent Metrics",
          "name": "Rule Failures",
          "options": {
            "description": "Rule runs that failed (condition, config, code or regex errors) in the selected time range.",
            "label": "Rule Failures",
            "plot": {
              "errorColumn": "",
              "groupBy": "",
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "",
              "datatype": "number",
              "sizeConfig": {
                "valueColumn": "value"
              }
            },
            "order": 7
          },
          "query": "sum(increase(apica_pipeline_rule_outcomes_total{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash', outcome='failed'}[{{__range}}])) or vector(0)&duration=1h",
          "schema": "apica_pipeline_rule_outcomes_total"
        },
        {
          "chart_type": "size",
          "data_source_name": "Ascent Metrics",
          "name": "Delivery Drops",
          "options": {
            "description": "Events handed to a forwarder but never delivered, in the selected time range.",
            "label": "Delivery Drops",
            "plot": {
              "errorColumn": "",
              "groupBy": "",
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "",
              "datatype": "number",
              "sizeConfig": {
                "valueColumn": "value"
              }
            },
            "order": 8
          },
          "query": "sum(increase(apica_forwarder_events_dropped_total{exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__range}}])) or vector(0)&duration=1h",
          "schema": "apica_forwarder_events_dropped_total"
        },
        {
          "chart_type": "counter",
          "data_source_name": "Ascent Metrics",
          "name": "Stalled Pipelines",
          "options": {
            "description": "Pipelines receiving events in the last 15 minutes that neither output nor filtered any. Current state; ignores the time range.",
            "label": "Pipelines",
            "order": 9
          },
          "query": "count(sum by (pipelineName)(rate(apica_pipeline_events_in{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[15m])) > 0 unless on (pipelineName) (sum by (pipelineName)(rate(apica_pipeline_events_out{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[15m])) > 0 or sum by (pipelineName)(rate(apica_pipeline_dropped_logs_counter{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[15m])) > 0)) or vector(0)",
          "schema": "apica_pipeline_events_in",
          "alert": {
            "active": "True",
            "name": "Pipeline stalled: events in but nothing out",
            "options": {
              "alertType": "simple alert",
              "anomalySwitch": false,
              "column": "value",
              "op": ">",
              "selectionCondition": "any",
              "timeColumn": "",
              "muted": false,
              "trackDuration": 15,
              "value": 0,
              "severityType": "warning"
            },
            "rearm": 300
          }
        },
        {
          "chart_type": "area",
          "data_source_name": "Ascent Metrics",
          "name": "Events In vs Out",
          "options": {
            "description": "Events per second entering and leaving all selected pipelines.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "direction"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "events/s"
            },
            "upperLimit": "",
            "order": 10
          },
          "query": "label_replace(sum(rate(apica_pipeline_events_in{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])), 'direction', 'in', '', '') or label_replace(sum(rate(apica_pipeline_events_out{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])), 'direction', 'out', '', '')&duration=1h&step=5m",
          "schema": "apica_pipeline_events_in"
        },
        {
          "chart_type": "area",
          "data_source_name": "Ascent Metrics",
          "name": "Bytes Saved by Pipeline",
          "options": {
            "description": "Bytes removed by rules per time step, stacked by pipeline. Points add up to Bytes Saved.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "pipelineName"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "bytes",
              "datatype": "bytes",
              "stacked": true
            },
            "upperLimit": "",
            "order": 11
          },
          "query": "sum by (pipelineName)(increase(apica_pipeline_savings_bytes{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}]))&duration=1h&step=5m",
          "schema": "apica_pipeline_savings_bytes"
        },
        {
          "chart_type": "line",
          "data_source_name": "Ascent Metrics",
          "name": "Volume Reduction by Pipeline",
          "options": {
            "description": "1 - bytes out / bytes in per pipeline. 50 means the pipeline passes on half of what it receives.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "pipelineName"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "% reduction"
            },
            "upperLimit": "",
            "order": 12
          },
          "query": "(1 - sum by (pipelineName)(rate(apica_ingest_pipeline_bytes_out{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])) / (sum by (pipelineName)(rate(apica_ingest_pipeline_bytes_in{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])) > 0)) * 100&duration=1h&step=5m",
          "schema": "apica_ingest_pipeline_bytes_in"
        },
        {
          "chart_type": "line",
          "data_source_name": "Ascent Metrics",
          "name": "Rule Latency p50 / p95 / p99",
          "options": {
            "description": "Time one rule takes on one event, from the rule duration histogram, across all selected pipelines.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "quantile"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "seconds"
            },
            "upperLimit": "",
            "order": 13
          },
          "query": "label_replace(histogram_quantile(0.5, sum by (le)(rate(apica_pipeline_rule_duration_seconds_bucket{pipelineName=~'.*', service='logiq-flash'}[{{__interval}}]))), 'quantile', 'p50', '', '') or label_replace(histogram_quantile(0.95, sum by (le)(rate(apica_pipeline_rule_duration_seconds_bucket{pipelineName=~'.*', service='logiq-flash'}[{{__interval}}]))), 'quantile', 'p95', '', '') or label_replace(histogram_quantile(0.99, sum by (le)(rate(apica_pipeline_rule_duration_seconds_bucket{pipelineName=~'.*', service='logiq-flash'}[{{__interval}}]))), 'quantile', 'p99', '', '')&duration=1h&step=5m",
          "schema": "apica_pipeline_rule_duration_seconds_bucket"
        },
        {
          "chart_type": "table",
          "data_source_name": "Ascent Metrics",
          "name": "Top Pipelines by Events In",
          "options": {
            "description": "The 20 pipelines that received the most events in the selected time range.",
            "plot": {
              "errorColumn": "",
              "groupBy": "",
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": ""
            },
            "order": 14
          },
          "query": "topk(20, sum by (pipelineName)(increase(apica_pipeline_events_in{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__range}}])))&duration=1h",
          "schema": "apica_pipeline_events_in"
        }
      ]
    },
    {
      "key": "Pipeline Traffic",
      "order": "2",
      "title": "Pipeline Traffic",
      "type": "metrics",
      "queriesList": [
        {
          "chart_type": "line",
          "data_source_name": "Ascent Metrics",
          "name": "Bytes In vs Out by Pipeline",
          "options": {
            "description": "Bytes per second entering and leaving each pipeline.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "pipelineName",
                "direction"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "bytes/s",
              "datatype": "bytes"
            },
            "upperLimit": "",
            "order": 1
          },
          "query": "label_replace(sum by (pipelineName)(rate(apica_ingest_pipeline_bytes_in{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])), 'direction', 'in', '', '') or label_replace(sum by (pipelineName)(rate(apica_ingest_pipeline_bytes_out{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])), 'direction', 'out', '', '')&duration=1h&step=5m",
          "schema": "apica_ingest_pipeline_bytes_in"
        },
        {
          "chart_type": "line",
          "data_source_name": "Ascent Metrics",
          "name": "Events In vs Out by Pipeline",
          "options": {
            "description": "Events per second entering and leaving each pipeline.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "pipelineName",
                "direction"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "events/s"
            },
            "upperLimit": "",
            "order": 2
          },
          "query": "label_replace(sum by (pipelineName)(rate(apica_pipeline_events_in{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])), 'direction', 'in', '', '') or label_replace(sum by (pipelineName)(rate(apica_pipeline_events_out{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])), 'direction', 'out', '', '')&duration=1h&step=5m",
          "schema": "apica_pipeline_events_in",
          "alert": {
            "active": "True",
            "name": "Pipeline EPS Anomaly Alert",
            "options": {
              "alertType": "anomaly alert",
              "anomalySwitch": false,
              "column": "Anomaly",
              "op": "==",
              "value": 1,
              "selectionCondition": "any",
              "timeColumn": "",
              "muted": false,
              "trackDuration": "60",
              "severityType": "warning"
            },
            "rearm": 300
          },
          "baseliningOptions": {
            "timeColumn": "timestamp",
            "valueColumn": "value",
            "operations": [
              "anomaly_detection"
            ],
            "windowSize": 12,
            "stdFraction": 1,
            "errorPercentage": 50,
            "mawindow": 384,
            "forecastDays": 1,
            "forecastHours": 5,
            "weekComparision": false,
            "weekComparisionTime": 24,
            "weekComparisionPercentage": 20,
            "anomalyGroupBy": [
              "pipelineName",
              "direction"
            ]
          }
        },
        {
          "chart_type": "line",
          "data_source_name": "Ascent Metrics",
          "name": "Volume Reduction by Dataflow",
          "options": {
            "description": "1 - bytes out / bytes in per pipeline, namespace and app.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "pipelineName",
                "exported_namespace",
                "app"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "% reduction"
            },
            "upperLimit": "",
            "order": 3
          },
          "query": "(1 - sum by (pipelineName, exported_namespace, app)(rate(apica_ingest_pipeline_bytes_out{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])) / (sum by (pipelineName, exported_namespace, app)(rate(apica_ingest_pipeline_bytes_in{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])) > 0)) * 100&duration=1h&step=5m",
          "schema": "apica_ingest_pipeline_bytes_in"
        },
        {
          "chart_type": "line",
          "data_source_name": "Ascent Metrics",
          "name": "Events Filtered by Pipeline",
          "options": {
            "description": "Events per second dropped by rules, per pipeline.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "pipelineName"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "events/s"
            },
            "upperLimit": "",
            "order": 4
          },
          "query": "sum by (pipelineName)(rate(apica_pipeline_dropped_logs_counter{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}]))&duration=1h&step=5m",
          "schema": "apica_pipeline_dropped_logs_counter"
        },
        {
          "chart_type": "table",
          "data_source_name": "Ascent Metrics",
          "name": "Pipeline to Dataflow Mapping",
          "options": {
            "description": "Namespace and app each pipeline runs on, with its execution order. Current state.",
            "plot": {
              "errorColumn": "",
              "groupBy": "",
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": ""
            },
            "order": 5
          },
          "query": "max by (pipelineName, exported_namespace, app, execution_order)(apica_ingest_pipeline_status{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'} > 0)",
          "schema": "apica_ingest_pipeline_status"
        }
      ]
    },
    {
      "key": "Rules",
      "order": "3",
      "title": "Rules",
      "type": "metrics",
      "queriesList": [
        {
          "chart_type": "area",
          "data_source_name": "Ascent Metrics",
          "name": "Rule Outcomes",
          "options": {
            "description": "Rule runs per second by outcome: unmatched, matched, transformed, dropped, bypassed, failed.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "outcome"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "runs/s",
              "stacked": true
            },
            "upperLimit": "",
            "order": 1
          },
          "query": "sum by (outcome)(rate(apica_pipeline_rule_outcomes_total{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}]))&duration=1h&step=5m",
          "schema": "apica_pipeline_rule_outcomes_total"
        },
        {
          "chart_type": "line",
          "data_source_name": "Ascent Metrics",
          "name": "Match Rate by Rule",
          "options": {
            "description": "Share of rule runs that matched (matched, transformed or dropped). A rule stuck at 0 never matches.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "pipelineName",
                "ruleName"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "% matched"
            },
            "upperLimit": "",
            "order": 2
          },
          "query": "sum by (pipelineName, ruleName)(rate(apica_pipeline_rule_outcomes_total{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash', outcome=~'matched|transformed|dropped'}[{{__interval}}])) / (sum by (pipelineName, ruleName)(rate(apica_pipeline_rule_outcomes_total{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash'}[{{__interval}}])) > 0) * 100&duration=1h&step=5m",
          "schema": "apica_pipeline_rule_outcomes_total"
        },
        {
          "chart_type": "line",
          "data_source_name": "Ascent Metrics",
          "name": "Rule Failures by Rule",
          "options": {
            "description": "Failed rule runs per time step, per pipeline and rule.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "pipelineName",
                "ruleName"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "failures"
            },
            "upperLimit": "",
            "order": 3
          },
          "query": "sum by (pipelineName, ruleName)(increase(apica_pipeline_rule_outcomes_total{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash', outcome='failed'}[{{__interval}}]))&duration=1h&step=5m",
          "schema": "apica_pipeline_rule_outcomes_total",
          "alert": {
            "active": "True",
            "name": "Rule failures sustained",
            "options": {
              "alertType": "simple alert",
              "anomalySwitch": false,
              "column": "value",
              "op": ">",
              "selectionCondition": "any",
              "timeColumn": "",
              "muted": false,
              "trackDuration": 15,
              "value": 0,
              "severityType": "warning"
            },
            "rearm": 300
          }
        },
        {
          "chart_type": "area",
          "data_source_name": "Ascent Metrics",
          "name": "Rule Failures by Reason",
          "options": {
            "description": "Failed rule runs by reason: condition, config, code, regex.",
            "plot": {
              "errorColumn": "",
              "groupBy": [
                "reason"
              ],
              "x": "timestamp",
              "xLabel": "Timestamp",
              "y": [
                "value"
              ],
              "yLabel": "runs",
              "stacked": true
            },
            "upperLimit": "",
            "order": 4
          },
          "query": "sum by (reason)(increase(apica_pipeline_rule_outcomes_total{pipelineName=~'.*', exported_namespace=~'.*', app=~'.*', service='logiq-flash', outcome='failed'}[{{__interval}}]))&duration=1h&step=5m",
          "schema": "apica_pipeline_rule_outcomes_total"
        },
        {
          "chart_type": "area",
          "data_source_name": "Ascent Metrics",
