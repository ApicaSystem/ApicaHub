{
    "header": {
        "dateTimeRange": true,
        "dropdowns": [],
        "data_source_type": "apica_ascent_prometheus",
        "title": "Logs Overview"
    },
    "tabs": [
        {
            "key": "Overview",
            "order": "1",
            "queriesList": [
                {
                    "chart_type": "line",
                    "data_source_name": "Ascent Metrics",
                    "name": "GB per hour (30d)",
                    "options": {
                        "description": "Data ingested per hour across the cluster, sampled hourly over 30 days",
                        "order": 1,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "GB / hour"
                        },
                        "upperLimit": ""
                    },
                    "query": "query=round(sum(increase(logiq_data_received_bytes[1h]))/1000000000,0.01)&duration=30d&step=1h",
                    "schema": "logiq_data_received_bytes"
                },
                {
                    "chart_type": "counter",
                    "data_source_name": "Ascent Metrics",
                    "name": "Log events (24h)",
                    "options": {
                        "description": "Total log events ingested in the last 24 hours, in millions",
                        "label": "million",
                        "order": 2,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "value"
                        },
                        "upperLimit": ""
                    },
                    "query": "round(sum(increase(logiq_message_count[24h]))/1000000,0.001)",
                    "schema": "logiq_message_count"
                },
                {
                    "chart_type": "gauge",
                    "data_source_name": "Ascent Metrics",
                    "name": "Ingest capacity utilization",
                    "options": {
                        "description": "Ingest rate as a percentage of assumed capacity. NOTE: capacity is hardcoded at 1 GB/hour per pod (the trailing *1 in the query); the number is only meaningful if that matches your real per-pod ceiling",
                        "order": 3,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "%"
                        },
                        "upperLimit": ""
                    },
                    "query": "((sum(rate(logiq_data_received_bytes[5m]))*3600/1000000000*1)/(count (count by (pod) (logiq_data_received_bytes))))*100",
                    "schema": "logiq_data_received_bytes"
                },
                {
                    "chart_type": "counter",
                    "data_source_name": "Ascent Metrics",
                    "name": "Messages / sec",
                    "options": {
                        "description": "Current message ingestion rate across the cluster, averaged over 5 minutes",
                        "label": "logs/sec",
                        "order": 4,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "value"
                        },
                        "upperLimit": ""
                    },
                    "query": "round(sum(rate(logiq_message_count[5m])),1)",
                    "schema": "logiq_message_count"
                },
                {
                    "chart_type": "line",
                    "data_source_name": "Ascent Metrics",
                    "name": "# Messages/sec by Namespace",
                    "options": {
                        "description": "Message ingestion rate per tenant namespace (msg/sec), sampled hourly over 30 days",
                        "order": 5,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "exported_namespace",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "msg / sec"
                        },
                        "upperLimit": ""
                    },
                    "query": "round(sum by (exported_namespace) (rate(logiq_namespace_app_message_count[1h])),1)&duration=30d&step=1h",
                    "schema": "logiq_namespace_app_message_count"
                },
                {
                    "chart_type": "counter",
                    "data_source_name": "Ascent Metrics",
                    "name": "Total GB ingested (30d)",
                    "options": {
                        "description": "Total data ingested across the cluster over the last 30 days",
                        "label": "GB",
                        "order": 6,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "value"
                        },
                        "upperLimit": ""
                    },
                    "query": "round(sum(increase(logiq_data_received_bytes[30d]))/1000000000,0.01)",
                    "schema": "logiq_data_received_bytes"
                },
                {
                    "chart_type": "bar",
                    "data_source_name": "Ascent Metrics",
                    "name": "HTTP Connection Rate (6h)",
                    "options": {
                        "description": "HTTP client connect and disconnect rate per second on ingest pods, over the last 6 hours",
                        "order": 7,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "operation",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "Connections / sec"
                        },
                        "upperLimit": ""
                    },
                    "query": "sum by (operation) (rate(logiq_client_connect_count{pod=~\"logiq-flash-\\\\d{1,3}\",connectionType=\"HTTP\"}[5m]))&duration=6h&step=5m",
                    "schema": "logiq_client_connect_count"
                },
                {
                    "chart_type": "area",
                    "data_source_name": "Ascent Metrics",
                    "name": "GB per day",
                    "options": {
                        "description": "Data ingested per day across the cluster, over the last 30 days",
                        "order": 8,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "GB / day"
                        },
                        "upperLimit": ""
                    },
                    "query": "round(sum(increase(logiq_data_received_bytes[24h]))/1000000000,0.001)&duration=30d&step=24h",
                    "schema": "logiq_data_received_bytes"
                },
                {
                    "chart_type": "line",
                    "data_source_name": "Ascent Metrics",
                    "name": "Connection Rate by Protocol (6h)",
                    "options": {
                        "description": "New client connections per second on ingest pods, split by ingest protocol, over the last 6 hours",
                        "order": 9,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "connectionType",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "Connections / sec"
                        },
                        "upperLimit": ""
                    },
                    "query": "sum by (connectionType) (rate(logiq_client_connect_count{pod=~\"logiq-flash-\\\\d{1,3}\",operation=\"connect\"}[5m]))&duration=6h&step=5m",
                    "schema": "logiq_client_connect_count"
                },
                {
                    "chart_type": "line",
                    "data_source_name": "Ascent Metrics",
                    "name": "Messages/sec by Protocol (6h)",
                    "options": {
                        "description": "Message ingestion rate split by ingest protocol, over the last 6 hours; panel 4 is the same measure with all protocols summed together",
                        "order": 10,
                        "plot": {
                            "errorColumn": "",
                            "groupBy": "connectionType",
                            "x": "timestamp",
                            "xLabel": "Timestamp",
                            "y": [
                                "value"
                            ],
                            "yLabel": "msg / sec"
                        },
                        "upperLimit": ""
                    },
                    "query": "round(sum by (connectionType) (rate(logiq_message_count[5m])),1)&duration=6h&step=5m",
                    "schema": "logiq_message_count"
                }
            ],
            "title": "Overview",
            "type": "metrics"
        }
    ]
}